# Admin credentials (change both values before deploying)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Nodemailer SMTP configuration for reservation confirmation emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Taste Africa <bookings@example.com>"

# Twilio configuration for reservation confirmation SMS messages
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
